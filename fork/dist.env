# Fork identity. Every value that says who publishes the builds lives here and
# nowhere else — fork/release.sh, fork/ios.sh and the fork-* workflows read it.
#
# Nothing in this file is a secret. Secrets (Apple certificate, app-specific
# password, Expo token) go in GitHub repo secrets on panrafal/paseo:
#   APPLE_CERTIFICATE  APPLE_CERTIFICATE_PASSWORD  APPLE_ID
#   APPLE_PASSWORD     APPLE_TEAM_ID               EXPO_TOKEN

# GitHub repo that hosts fork releases and the desktop auto-update feed.
FORK_GH_OWNER=panrafal
FORK_GH_REPO=paseo

# --- iOS / TestFlight ------------------------------------------------------
# Replace every REPLACE_ME before running fork/ios.sh; it refuses to run with
# placeholders in place.

# Your own bundle identifier. MUST differ from upstream's sh.paseo.
FORK_IOS_BUNDLE_ID=REPLACE_ME_BUNDLE_ID

# Expo account that owns the fork's EAS project (`eas whoami`).
FORK_EAS_OWNER=REPLACE_ME_EXPO_ACCOUNT

# EAS project id for the fork. Create it once with:
#   cd packages/app && npx eas init --id
FORK_EAS_PROJECT_ID=REPLACE_ME_EAS_PROJECT_ID

# App Store Connect app id (the numeric "Apple ID" on the App Information page).
FORK_ASC_APP_ID=REPLACE_ME_ASC_APP_ID

# Apple Developer Team ID (also used for the macOS notarization).
FORK_APPLE_TEAM_ID=REPLACE_ME_APPLE_TEAM_ID
