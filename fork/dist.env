# Fork identity. Every value that says who publishes the builds lives here and
# nowhere else — fork/release.sh, fork/ios.sh and the fork-* workflows read it.
#
# Nothing in this file is a secret. The Apple signing secrets are GitHub repo
# secrets on panrafal/paseo, read by .github/workflows/fork-desktop.yml:
#   APPLE_CERTIFICATE  APPLE_CERTIFICATE_PASSWORD
#   APPLE_API_KEY_P8   APPLE_API_KEY_ID             APPLE_API_ISSUER
#
# Notarization uses an App Store Connect API key, so no Apple ID or
# app-specific password is stored anywhere. FORK_APPLE_TEAM_ID below is still
# needed for iOS, but it is no longer a GitHub secret.
#
# EXPO_TOKEN is not one of them. fork/ios.sh runs on your own machine, not in
# Actions, so the token lives encrypted in fork/.env.fork and dotenvx decrypts
# it into the script's environment. See fork/README.md.

# GitHub repo that hosts fork releases and the desktop auto-update feed.
FORK_GH_OWNER=panrafal
FORK_GH_REPO=paseo

# --- iOS / TestFlight ------------------------------------------------------
# Replace every REPLACE_ME before running fork/ios.sh; it refuses to run with
# placeholders in place.

# Your own bundle identifier. MUST differ from upstream's sh.paseo.
FORK_IOS_BUNDLE_ID=pl.stamina.paseo

# Expo account that owns the fork's EAS project (`eas whoami`).
FORK_EAS_OWNER=capitally

# EAS project id for the fork. Create the project on expo.dev with the slug
# `panrafal-paseo` (it must match expo.slug in packages/app/app.config.js), then
# link it with `cd packages/app && npx eas init --id=<project id>`.
FORK_EAS_PROJECT_ID=333faca8-6197-426a-ac87-fd018be2ce98

# App Store Connect app id (the numeric "Apple ID" on the App Information page).
FORK_ASC_APP_ID=6808767777

# Apple Developer Team ID used for the iOS build and submission.
FORK_APPLE_TEAM_ID=99ZXR687RS
